FROM golang:1.21-alpine

WORKDIR /app

# Instalar air para hot reload e outras dependências
RUN go install github.com/cosmtrek/air@latest && \
    apk add --no-cache git ca-certificates tzdata

# Copiar go.mod e go.sum
COPY go.mod go.sum ./
RUN go mod download

# Copiar código fonte (será sobrescrito pelo volume)
COPY . .

# Criar diretórios
RUN mkdir -p tmp logs

# Expor porta
EXPOSE 7070

# Usar air para hot reload
CMD ["air", "-c", ".air.toml"]
